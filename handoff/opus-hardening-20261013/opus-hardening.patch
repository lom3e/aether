diff --git a/tests/conftest.py b/tests/conftest.py
index 3e938ce..77c904a 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -274,3 +274,33 @@ def make_test_accepted_authority(
 @pytest.fixture
 def accepted_authority_factory():
     return make_test_accepted_authority
+
+
+# ---------------------------------------------------------------------------
+# Credential and network isolation for ordinary tests (audit finding 7).
+# Only tests marked ``live_provider`` (or ``integration``) see the process' API keys and may reach the network.
+# ---------------------------------------------------------------------------
+_PROVIDER_KEY_VARS = ("GROQ_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY")
+_LOOPBACK = {"127.0.0.1", "::1", "localhost"}
+_OLLAMA_PORT = 11434
+
+
+@pytest.fixture(autouse=True)
+def _isolate_credentials_and_network(request, monkeypatch):
+    if request.node.get_closest_marker("live_provider") or request.node.get_closest_marker("integration"):
+        yield
+        return
+    for var in _PROVIDER_KEY_VARS:
+        monkeypatch.delenv(var, raising=False)
+
+    real_connect = socket.socket.connect
+
+    def guarded_connect(self, address, *args, **kwargs):
+        host, port = (address[0], address[1]) if isinstance(address, tuple) and len(address) >= 2 else (None, None)
+        if host is not None and (host not in _LOOPBACK or port == _OLLAMA_PORT):
+            raise RuntimeError(f"Ordinary tests must not open network connections (attempted {host}:{port}); "
+                               f"mark the test live_provider/integration if it really needs a provider.")
+        return real_connect(self, address, *args, **kwargs)
+
+    monkeypatch.setattr(socket.socket, "connect", guarded_connect)
+    yield
