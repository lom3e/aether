{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "1.7.0",
  "identifier": "com.aether.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build:ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' tauri: http://localhost:8000 http://127.0.0.1:8000 ws://localhost:8000 ws://127.0.0.1:8000; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* tauri: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https: asset:; font-src 'self' data:;"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NDQwQkU0MDVBNjgyMjUKUldRbGdxWUY1QXRFeERhNDFIdUZrQTM3NGlVZlBDQkgxZTBJWHBwUWFDRnh2anJhcGtBRjluS1oK",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
